{
  "name": "dsh-comm-protocol-hub",
  "version": "1.0.0",
  "description": "3GPP通信协议知识库与分类可视化工具 — 集成NTN/TN/全息通信/近远场通信等全维度协议查询",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.host.json && tsc -p tsconfig.client.json --incremental false",
    "typecheck": "tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "verify": "pnpm typecheck && pnpm build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0",
    "@deepseek-ai/schemastery": ">=0.1.0",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-runtime"]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/example/comm-protocol-hub"
  },
  "keywords": [
    "3gpp",
    "telecom",
    "protocol",
    "ntn",
    "tn",
    "holographic",
    "near-field",
    "far-field",
    "deepseek-harness",
    "dsh-plugin"
  ]
}
